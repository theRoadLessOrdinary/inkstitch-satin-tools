<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">

	<name>Edit Ladder Rungs</name>
	<id>maps_edge.rung_rail_satin</id>

	<param name="help" type="description">Select one or more ladders (2 rails plus rungs), and/or separate rail paths in pairs. Shift+click rails in order: rails 1 and 2 become one ladder, 3 and 4 the next, and so on. Add: builds all rungs if there are none, otherwise inserts a rung between each pair of existing rungs. Decimate: removes every other rung. The 4 rungs at each end are never touched.</param>

	<param name="mode" type="optiongroup" appearance="radio" gui-text="Mode:">
		<option value="add">Add</option>
		<option value="decimate">Decimate</option>
	</param>

	<effect>
		<object-type>all</object-type>
		<effects-menu>
			<submenu name="Map's Edge Tools" translatable="no">
				<submenu name="Embroidery" translatable="no">
					<submenu name="Satin" translatable="no" />
				</submenu>
			</submenu>
		</effects-menu>
	</effect>

	<script>
		<command location="inx" interpreter="python">edit_ladder_rungs.py</command>
	</script>

</inkscape-extension>
